{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "ColorBehavior": "Enabled"
      }
    },
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Ports": {
    "Http": "8081"
  }
}
