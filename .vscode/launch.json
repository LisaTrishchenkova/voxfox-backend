{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "VoxFox API (http profile)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/VoxFox/bin/Debug/net9.0/VoxFox.dll",
            "args": [
                "--launch-profile", "http"
            ],
            "cwd": "${workspaceFolder}/VoxFox",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "VoxFox API (https profile)",
            "type": "coreclr",
