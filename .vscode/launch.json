{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch VoxFox API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/VoxFox/bin/Debug/net9.0/VoxFox.dll",
            "args": [],
            "cwd": "${workspaceFolder}/VoxFox",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "integratedTerminal"
        }
    ]
}
