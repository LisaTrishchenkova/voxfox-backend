            "program": "${workspaceFolder}/VoxFox/bin/Debug/net9.0/VoxFox.dll",
            "args": [
                "--launch-profile", "Container (Dockerfile)"
            ],
            "cwd": "${workspaceFolder}/VoxFox",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
